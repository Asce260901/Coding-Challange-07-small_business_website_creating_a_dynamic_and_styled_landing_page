# Copy to .env.local for local dev, and set these in your hosting provider's dashboard for production.

# Public URL of the deployed site (used for canonical URLs, sitemap, social previews).
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Contact form email delivery via Resend (https://resend.com). Without a key the form
# logs to the console in dev and shows a "call us" message in production.
RESEND_API_KEY=
# Where estimate requests are delivered (defaults to the address in lib/site.ts).
CONTACT_TO_EMAIL=jlrupholstery@gmail.com
# Must be an address on a domain verified in Resend. The default only delivers to your own Resend account email.
CONTACT_FROM_EMAIL=JLR Upholstery <quotes@your-domain.com>
